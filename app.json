{
  "expo": {
    "name": "Recycle Connect",
    "slug": "recycle-connect",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.ajijicrecycling.recycleconnect",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Recycle Connect uses your location to set your pickup address and to show drivers nearby pickups."
      },
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f9f9f9"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mx.ajijicrecycling.recycleconnect",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Recycle Connect",
      "shortName": "Recycle",
      "themeColor": "#004e49",
      "backgroundColor": "#f8faf8",
      "lang": "es"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#f9f9f9"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Recycle Connect uses your location to set your pickup address and to show drivers nearby pickups."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Recycle Connect uses the camera so drivers can photograph bags left at the door as proof of pickup.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "recycleconnect",
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/recycling-app"
    }
  }
}
